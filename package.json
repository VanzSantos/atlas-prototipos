{
  "name": "atlas-prototipos",
  "private": true,
  "description": "Atlas — plataforma central de protótipos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix plataforma install --ignore-scripts --no-audit --no-fund",
    "validar": "node scripts/validar-prototipos.mjs",
    "catalogo": "node scripts/gerar-catalogo.mjs",
    "dev": "node scripts/montar-site.mjs --saida plataforma/gerado --sem-plataforma && npm --prefix plataforma run dev",
    "build": "node scripts/montar-site.mjs --saida site"
  }
}
